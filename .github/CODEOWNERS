# Who has to look at what before it is merged.

*                                   @uplytech/packages

# The two editions
/python/                            @uplytech/packages
/typescript/                        @uplytech/packages

# Automation, publishing credentials and the release path
/.github/                           @uplytech/owners

# Release-decision territory: a one-line change here moves behaviour for
# every caller, so it is never merged on one pair of eyes.
/python/src/rankmode/curves.py       @uplytech/owners @uplytech/packages
/typescript/src/curves.ts            @uplytech/owners @uplytech/packages
/typescript/src/exact.ts             @uplytech/owners @uplytech/packages
/shared/                             @uplytech/owners @uplytech/packages

# The same, for the ranked half. `fixed` is the foundation the rating maths
# stands on and `rating` is the formula itself: a change to either moves every
# player's rank, and `fixed` moves the curves too if it is ever shared.
/python/src/rankmode/fixed.py        @uplytech/owners @uplytech/packages
/python/src/rankmode/rating.py       @uplytech/owners @uplytech/packages
/python/src/rankmode/ladder.py       @uplytech/owners @uplytech/packages
/typescript/src/fixed.ts             @uplytech/owners @uplytech/packages
/typescript/src/rating.ts            @uplytech/owners @uplytech/packages
/typescript/src/ladder.ts            @uplytech/owners @uplytech/packages

