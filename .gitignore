# Node
node_modules/
# typescript/package-lock.json is committed on purpose: CI installs with
# `npm ci`, which needs it, and a library whose contributors resolve different
# dev-tool versions is a library whose "eslint clean" means different things to
# different people.
typescript/dist/
coverage/
*.tgz
.tsup/

# Differential harness output. parity.sh writes to a scratch directory; a bare
# `node generate.mjs` writes here.
shared/tools/differential/cases.json
shared/tools/differential/results-*.json

