{
  "name": "@uplytech/rankmode",
  "version": "3.0.0",
  "description": "Experience points, levels and leaderboards for Discord bots, forums and websites. Pure calculation: no storage, no platform binding, no display. Curves, cooldowns, period caps, multipliers, decay, tie-safe leaderboards and curve migration.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests examples",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "examples": "vite-node examples/basic.ts && vite-node examples/discord-bot-integration.ts && vite-node examples/ranked-season.ts",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "xp",
    "experience",
    "levels",
    "levelling",
    "leveling",
    "ranking",
    "leaderboard",
    "gamification",
    "discord-bot",
    "community",
    "forum",
    "uplytech",
    "rankmode"
  ],
  "author": "UplyTech <dev@uplytech.de>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UplyTech/RankMode.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/UplyTech/RankMode/issues"
  },
  "homepage": "https://github.com/UplyTech/RankMode#readme",
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "fast-check": "^3.22.0",
    "tsup": "^8.3.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "sideEffects": false
}
